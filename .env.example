# Copie este arquivo para .env quando o projeto começar a usar configurações.
# Nunca coloque senhas ou chaves reais neste arquivo de exemplo.

APP_ENV=development
LOG_LEVEL=INFO

# Automação semanal local (sem valores secretos reais)
JOB_AGENT_DB=data/job_agent.db
JOB_AGENT_WEEKDAY=Monday
JOB_AGENT_HOUR=8
JOB_AGENT_MINUTE=0
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Job CRM
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
